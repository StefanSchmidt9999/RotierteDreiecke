<Page
    x:Class="RotierteDreiecke.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RotierteDreiecke">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Buttons -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="10">

            <Button
                Content="Dreiecke zeichnen"
                Click="StartButton_Click"
                Margin="5"/>

            <Button
                Content="Löschen"
                Click="ClearButton_Click"
                Margin="5"/>

        </StackPanel>


        <!-- Zeichenfläche -->
        <Border
            Grid.Row="1"
            Width="600"
            Height="600"
            BorderBrush="Black"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="10">

            <Canvas
                x:Name="DrawCanvas"
                Width="600"
                Height="600"
                Background="White"/>
        </Border>
    </Grid>
</Page>